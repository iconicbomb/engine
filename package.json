{ "name": "engine", "private": true, "version": "0.0.1",
  "scripts": {
    "test": "tsx packages/graph/test/validate.ts fixtures/r3-hook.graph.json && tsx packages/runtime/test/test-core.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "pnpm --filter @app/render preview",
    "render": "pnpm --filter @app/render render",
