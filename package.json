{
  "name": "engine",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "test": "tsx packages/graph/test/validate.ts fixtures/r3-hook.graph.json && tsx packages/runtime/test/test-core.ts && tsx packages/patterns/test/test-patterns.ts && tsx --tsconfig tsconfig.json packages/planner/test/test-planner.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "pnpm --filter @app/render preview",
    "render": "pnpm --filter @app/render render",
    "compare": "python tools/compare_frames.py fixtures/refs/R3.mp4 apps/render/out/r3.mp4 --dur 3.2 --out out/compare_strip.png",
    "render:local": "node tools/render-local.mjs fixtures/r3-hook.graph.json out/r3-local.mp4",
    "compare:local": "python tools/compare_frames.py fixtures/refs/R3.mp4 out/r3-local.mp4 --dur 3.2 --out out/compare_strip_local.png",
    "gen:r3": "tsx tools/gen-fixtures.ts r3-hook",
    "gen:fixtures": "tsx tools/gen-fixtures.ts",
    "test:render": "node tools/render-check.mjs",
    "plan": "tsx --tsconfig tsconfig.json packages/planner/src/cli.ts plan",
    "make": "tsx --tsconfig tsconfig.json packages/planner/src/cli.ts make",
    "render:showcase": "node tools/render-local.mjs fixtures/showcase.graph.json out/showcase-16x9.mp4 --aspect 16:9 --no-frames && node tools/render-local.mjs fixtures/showcase.graph.json out/showcase-9x16.mp4 --aspect 9:16 --no-frames"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@types/node": "22.10.2",
    "esbuild": "0.24.0",
    "playwright": "1.49.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "wawoff2": "2.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
